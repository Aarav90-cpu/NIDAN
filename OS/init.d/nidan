#!/sbin/openrc-run

name="nidan"
description="NIDAN Educational Platform Service"
command="/usr/local/bin/nidan"
command_background="true"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/nidan.log"
error_log="/var/log/nidan.err"

export NIDAN_BIND_HOST="0.0.0.0"
export NIDAN_API_PORT="8080"
export NIDAN_DB_PATH="/var/lib/nidan/nidan.sqlite"
export NIDAN_PUBLIC_DIR="/var/lib/nidan/www"

depend() {
    need localmount
    use net
    after firewall
}

start_pre() {
    if [ ! -x "/usr/local/bin/nidan" ]; then
        return 0
    fi
    mkdir -p /var/lib/nidan /var/log
    checkpath -d -m 0755 -o root:root /var/lib/nidan
}

start() {
    if [ -x "/usr/local/bin/nidan" ]; then
        default_start
        sleep 1
        if wget -q -T 1 -O /dev/null http://127.0.0.1:8080/api/status >/dev/null 2>&1; then
            return 0
        fi
    fi

    HTTPD_BIN=""
    for b in /usr/sbin/httpd /sbin/httpd /usr/bin/httpd /bin/httpd; do
        if [ -x "$b" ]; then
            HTTPD_BIN="$b"
            break
        fi
    done
    if [ -n "$HTTPD_BIN" ]; then
        ebegin "Starting NIDAN offline HTTP service"
        $HTTPD_BIN -p 0.0.0.0:8080 -h /var/lib/nidan/www
        eend $?
    fi
}

stop() {
    if [ -f "$pidfile" ]; then
        default_stop
    fi
    pkill -f "httpd -p.*8080" 2>/dev/null || true
}
