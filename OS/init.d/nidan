#!/sbin/openrc-run

name="nidan"
description="NIDAN Educational Platform Service"
command="/usr/local/bin/nidan"
command_background="true"
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/nidan.log"
error_log="/var/log/nidan.err"

export NIDAN_BIND_HOST="0.0.0.0"
export NIDAN_API_PORT="8080"
export NIDAN_DB_PATH="/var/lib/nidan/nidan.sqlite"
export NIDAN_PUBLIC_DIR="/var/lib/nidan/www"

depend() {
    need localmount
    use net
    after firewall
}

start_pre() {
    if [ ! -x "/usr/local/bin/nidan" ]; then
        return 0
    fi
    mkdir -p /var/lib/nidan /var/log
    checkpath -d -m 0755 -o root:root /var/lib/nidan
}

start() {
    if [ ! -x "/usr/local/bin/nidan" ]; then
        return 0
    fi
    default_start
}

stop() {
    if [ ! -x "/usr/local/bin/nidan" ]; then
        return 0
    fi
    default_stop
}
